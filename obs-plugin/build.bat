@echo off
REM Build the CineRemote Camera OBS source plugin with MSVC (Visual Studio 2022 / Build Tools, C++ workload).
REM Compiles against the libobs headers (fetched into third_party\ on the first build) and links obs.dll
REM through an import library made from obs-imports.def - OBS itself is not needed to build.
REM   set OBS_VER=32.1.2   to pick the libobs header version (any recent OBS loads the result)
setlocal
set ROOT=%~dp0
if not defined OBS_VER set OBS_VER=32.1.2
set SRC=%ROOT%third_party\obs-studio-%OBS_VER%
set OUT=%ROOT%out
if not exist "%OUT%" mkdir "%OUT%"
call "%~dp0..\tools\vsenv.bat" || exit /b 1

if exist "%SRC%\libobs\obs-module.h" goto :have_headers
echo [build] fetching libobs %OBS_VER% headers
git clone -q --depth 1 --filter=blob:none --sparse --branch %OBS_VER% https://github.com/obsproject/obs-studio.git "%SRC%"
if errorlevel 1 ( echo [build] git clone failed & exit /b 1 )
git -C "%SRC%" sparse-checkout set libobs deps/libcaption
:have_headers
REM obsconfig.h is generated by OBS's CMake; plugins only need it to exist.
if not exist "%SRC%\libobs\obsconfig.h" (
  > "%SRC%\libobs\obsconfig.h" echo #pragma once
  >> "%SRC%\libobs\obsconfig.h" echo #define OBS_DATA_PATH "../../data"
  >> "%SRC%\libobs\obsconfig.h" echo #define OBS_PLUGIN_PATH "../../obs-plugins/64bit"
  >> "%SRC%\libobs\obsconfig.h" echo #define OBS_RELEASE_CANDIDATE 0
  >> "%SRC%\libobs\obsconfig.h" echo #define OBS_BETA 0
)

lib /nologo /def:"%ROOT%obs-imports.def" /out:"%OUT%\obs.lib" /machine:x64 >nul
if errorlevel 1 ( echo [build] import library failed & exit /b 1 )

echo [build] compiling plugin
cl /nologo /c /O2 /MD /std:c11 /W3 /DNDEBUG /D_CRT_SECURE_NO_WARNINGS ^
   /I "%SRC%\libobs" /I "%ROOT%src" ^
   "%ROOT%src\plugin-main.c" /Fo"%OUT%\plugin-main.obj"
if errorlevel 1 ( echo [build] compile failed & exit /b 1 )

echo [build] linking
link /nologo /DLL /machine:x64 /OUT:"%OUT%\cineremote-obs.dll" ^
   "%OUT%\plugin-main.obj" "%OUT%\obs.lib" kernel32.lib
if errorlevel 1 ( echo [build] link failed & exit /b 1 )

echo [build] OK -^> %OUT%\cineremote-obs.dll
endlocal
