; libobs functions the plugin calls. build.bat turns this into an import library for obs.dll,
; so building on Windows needs only the libobs headers, not an OBS install.
; Add a name here if the plugin starts using another libobs function (the linker will say which).
LIBRARY obs
EXPORTS
  bfree
  blog
  bmalloc
  obs_data_get_bool
  obs_data_get_string
  obs_data_set_default_bool
  obs_data_set_default_string
  obs_module_load_locale
  obs_properties_add_bool
  obs_properties_add_button2
  obs_properties_add_list
  obs_properties_create
  obs_property_list_add_string
  obs_register_source_s
  obs_source_output_audio
  obs_source_output_video
  obs_source_set_async_unbuffered
  os_event_destroy
  os_event_init
  os_event_signal
  os_event_timedwait
  os_gettime_ns
  os_set_thread_name
  text_lookup_destroy
  text_lookup_getstr
  video_format_get_parameters
